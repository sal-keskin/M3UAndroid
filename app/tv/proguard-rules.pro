# The TV remote-control server (TvRepositoryImpl.broadcastOnTv) runs Ktor on Netty, which creates
# its channel classes reflectively (ReflectiveChannelFactory). Same rules as :app:smartphone;
# without them release builds crash on launch on a television.
-keep class io.netty.** { *; }
-keep class io.ktor.** { *; }
-keep class kotlin.reflect.jvm.internal.** { *; }

# Optional codecs and native helpers Netty and Ktor reference but the app never loads
# (generated by R8 into missing_rules.txt once io.netty / io.ktor are kept).
-dontwarn com.aayushatharva.brotli4j.Brotli4jLoader
